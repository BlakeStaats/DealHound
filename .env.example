# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Dylan's oracle signer address (the one POST /quote signs with)
ORACLE_ADDRESS=0x0000000000000000000000000000000000000000

# Deployer private key (funded with Monad testnet MON)
PRIVATE_KEY=0x

# Monad testnet (chain 10143)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# For `forge verify-contract` (fill in once we know Monad's verifier)
ETHERSCAN_API_KEY=
MONAD_VERIFIER_URL=
